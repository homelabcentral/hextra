{
  "name": "Hextra - theme development",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspaces/hextra",

  // SSH: git over SSH inside the container needs two separate things, and only
  // one of them is configuration.
  //
  // 1. Signing. VS Code forwards the host ssh-agent automatically - it starts a
  //    helper in the container, creates a fresh socket there, proxies the agent
  //    protocol back to the host and sets SSH_AUTH_SOCK. Nothing to declare,
  //    and no way to opt out. The host socket is never bind-mounted, so the
  //    macOS launchd socket path is irrelevant. Private keys stay on the host.
  //
  // 2. Choosing WHICH key. A forwarded agent offers every key it holds, in
  //    agent order, and GitHub accepts the first one that maps to an account,
  //    then stops - so a host with more than one GitHub key authenticates as
  //    whichever it happened to offer first. ssh's only selection mechanism is
  //    IdentityFile + IdentitiesOnly (ssh_config(5)); there is no way to pick
  //    by fingerprint or comment.
  //
  //    That selection is declared, not inherited. `ssh-config` in this
  //    directory is mounted over ~/.ssh/config and names one identity,
  //    `id_container`, which docker-compose.yml binds to one host key. The
  //    host's own ~/.ssh is not mounted: reading it is what dragged every
  //    other identity in, and which key a container uses is a property of the
  //    container rather than of the machine it runs on.
  //
  // The mounts are declared in docker-compose.yml, NOT here, and deliberately
  // so. The equivalent for this file is written out below, commented;
  // uncommenting it works, but the `readonly` would be silently discarded,
  // giving read-write access to the host's real private keys. The reason is
  // that the two orchestrators take different paths through the devcontainers
  // CLI:
  //
  //   - image/Dockerfile containers (spec-node/singleContainer.ts) pass the
  //     mount string through verbatim as `--mount <string>`, so Docker itself
  //     parses `readonly` and it works.
  //   - compose containers (spec-node/dockerCompose.ts) parse it into a Mount
  //     object first and re-emit it into a generated override file via
  //     convertMountToVolume(), which builds `${source}:${target}` and nothing
  //     else. The Mount interface is { type, source, target, external } - it
  //     has no readonly field, so the flag is gone before the volume string is
  //     built. No warning is issued.
  //
  // This repo is compose-based ("dockerComposeFile" above), so the mounts live
  // in docker-compose.yml where long syntax supports read_only: true.
  //
  // Read-only costs nothing: the three mounted files are all ones the container
  // has no business writing, and ~/.ssh itself is a container-owned directory,
  // so ssh can still write known_hosts there. Under the old whole-directory
  // mount it could not, and every first connection warned. In exchange nothing
  // running here (npm lifecycle scripts, Playwright, act, go install) can
  // modify or delete a host key.
  //
  // `IgnoreUnknown UseKeychain` on the host is no longer a requirement. That
  // was needed because Linux OpenSSH aborts the entire file on the macOS-only
  // `UseKeychain` keyword, and the container used to parse the host's config.
  // It no longer reads it.
  //
  // Ready to uncomment. If you do, DELETE the corresponding bind entries from
  // docker-compose.yml first - two mounts on the same target is an error - and
  // accept that these are read-write.
  //
  // "mounts": [
  //   "source=${localEnv:HOME}/.ssh/homelabcentral,target=/home/vscode/.ssh/id_container,type=bind,readonly",
  //   "source=${localWorkspaceFolder}/.devcontainer/ssh-config,target=/home/vscode/.ssh/config,type=bind,readonly"
  // ],
  "features": {
    "ghcr.io/devcontainers/features/hugo:1": {
      "extended": true,
      "version": "0.166.0"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    // Docker CLI against the host daemon (socket mounted in docker-compose.yml)
    // so `make ci*` can run act inside the container.
    // moby: false — the moby packages don't exist on Debian trixie (this
    // image's base); Docker's official CLI packages do.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/act:1": {},
    // GitHub CLI, authenticated as whoever owns the token in GH_TOKEN (see the
    // environment block in docker-compose.yml). Needed because git over SSH and
    // the GitHub API authenticate separately: the forwarded agent covers pushes,
    // but `gh pr create` is a REST call and needs a token of its own.
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "mhutchie.git-graph",
        "esbenp.prettier-vscode",
        "tamasfe.even-better-toml",
        "budparr.language-hugo-vscode",
        "bradlc.vscode-tailwindcss",
        "austenc.tailwind-docs",
        "Zarifprogrammer.tailwind-snippets",
        "kamikillerto.vscode-colorize",
        "ecmel.vscode-html-css",
        "Zignd.html-css-class-completion"
      ]
    }
  },
  // docs/public is gitignored and will not exist on a fresh clone. Create it on
  // the host first, otherwise Docker creates it as root and the build cannot
  // write there.
  "initializeCommand": "mkdir -p docs/public",
  // The node_modules named volume (docker-compose.yml) is created empty and
  // root-owned, because nothing exists at that path in the image for Docker to
  // seed ownership from. Claim it for the container user before installing,
  // otherwise npm fails with EACCES on the first mkdir.
  //
  // Playwright browsers are not in the image and not in node_modules; they go
  // to ~/.cache/ms-playwright. Run unprivileged so that cache is owned by the
  // container user; --with-deps elevates on its own for the apt step only.
  // Chromium only: playwright.config.ts declares no projects.
  //
  // Then the two content-authoring tools: freeze renders code snippets to SVG
  // with the font embedded, asciinema records the .cast files the asciinema
  // shortcode plays. Last so a failure here cannot block npm or the Playwright
  // browser download, which the test suite depends on - and independent of
  // each other, and non-fatal. They were `&&`-chained to the required steps
  // and to each other, so an unpinned `apt-get` hiccup skipped freeze and
  // failed postCreateCommand outright, after which `make doctor` advises
  // reopening in the devcontainer: the step that had just failed. Neither
  // tool is needed to build, test or preview the site.
  //
  // freeze needs no sudo and no arch detection: the base image (golang:trixie)
  // sets GOPATH=/go and puts /go/bin on PATH, and freeze is pure Go, no cgo.
  // Pinned; `go install` verifies it against sum.golang.org.
  //
  // asciinema comes from Debian rather than upstream - 2.4.0 against 3.2.1 -
  // which costs `asciinema convert` and live streaming, neither of which is
  // needed to produce docs casts. It records asciicast v2 and the player is
  // loaded unpinned from jsDelivr, which reads v2 and v3 both.
  //
  // The apt-get update is deliberate even though `playwright install
  // --with-deps` directly above runs one of its own; depending on that as an
  // implicit side effect would break the moment the Playwright step moves.
  // This runs on every create, and "Rebuild Container" always creates.
  //
  // The ~/.ssh chown comes first and is NOT recursive: Docker creates that
  // directory root-owned, so ssh cannot write known_hosts and re-asks to trust
  // github.com on every connection - while the key mounted inside it is
  // read-only, which a recursive chown would fail on.
  //
  // ~/.ssh/config is a symlink to `.devcontainer/ssh-config` rather than a
  // mount of its own. The file is in the repository and the repository is
  // already mounted, so a second bind of the same file would be the same bytes
  // twice; the symlink also means an edit applies on the next connection
  // instead of on the next rebuild. ssh resolves the link before its
  // permission check, and the target arrives through the bind as vscode-owned
  // and not group-writable, which is what that check wants.
  //
  // What it downloads is held across rebuilds by three named volumes declared in
  // docker-compose.yml - the Playwright browser, the Go module cache and
  // /go/bin - because none of them change between rebuilds and all three would
  // otherwise be fetched again. Docker creates a named volume root-owned, so
  // they are chowned here, once, before anything writes to them.
  //
  // `--with-deps` stays: the browser now comes from the volume, but the OS
  // packages it needs live in the container filesystem and do go away. Same
  // for asciinema, so its guard only helps when postCreateCommand is re-run
  // rather than on a rebuild; freeze is the one that skips outright, from
  // /go/bin.
  "postCreateCommand": "sudo chown \"$(id -u):$(id -g)\" /home/vscode/.ssh && sudo chmod 700 /home/vscode/.ssh && ln -sfn \"${containerWorkspaceFolder}/.devcontainer/ssh-config\" /home/vscode/.ssh/config && sudo chown -R \"$(id -u):$(id -g)\" node_modules /home/vscode/.cache/ms-playwright /go/pkg /go/bin && npm install && npx playwright install --with-deps chromium || exit 1; command -v asciinema >/dev/null 2>&1 || { sudo apt-get update && sudo apt-get install -y --no-install-recommends asciinema; } || echo 'devcontainer: asciinema unavailable (optional, docs casts only)'; command -v freeze >/dev/null 2>&1 || go install github.com/charmbracelet/freeze@v0.2.2 || echo 'devcontainer: freeze unavailable (optional, snippet SVGs only)'; gh repo set-default homelabcentral/hextra 2>/dev/null || true;",
  // Docker Desktop's VirtioFS periodically serves uid 0 for the *root inode* of
  // a bind mount. Measured in this container: 32 of 300 reads (~11%), in ~1s
  // windows roughly every 25s. Children are never affected - 0 of 300 on both
  // the repo and .git - because they are looked up from their parent, while the
  // mount root has no parent and is answered from a separate code path.
  //
  // Git checks the ownership of the worktree, which here is the mount root, so
  // ~11% of git calls see uid 0 and abort with "detected dubious ownership".
  // hugo.yaml sets enableGitInfo, so `make preview` makes hundreds of git calls
  // per build and reliably loses that lottery; the Source Control panel goes
  // blank for the same reason.
  //
  // This does not repair the ownership - nothing can, the value is fabricated
  // per-read and is not stored anywhere - it tells git to stop consulting it.
  // See docker/for-mac#6298 and #6243, both open.
  //
  // It is set twice, in two mechanisms, because they fail in different ways.
  //
  // `containerEnv` is the one that actually holds. GIT_CONFIG_COUNT and its
  // numbered key/value pairs are read by git as configuration of the highest
  // precedence, and an environment variable exists from the moment a process
  // starts - so there is no window in which git can run without it. The
  // postStartCommand alone left one: it runs after the container starts and
  // after VS Code attaches, while the git extension begins probing the
  // repository immediately, which is why the warning appeared on open and then
  // stopped mattering a second later.
  //
  // The command stays as the fallback for anything that clears the
  // environment, and because it writes the value where a plain `git config
  // --list` will show it. postStart rather than postCreate: the ownership is
  // wrong intermittently for the life of the container, not just at creation,
  // and the container's ~/.gitconfig does not survive a rebuild anyway.
  // Guarded so repeated starts do not append duplicate entries.
  "containerEnv": {
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "safe.directory",
    "GIT_CONFIG_VALUE_0": "${containerWorkspaceFolder}"
  },
  "postStartCommand": "git config --global --get-all safe.directory 2>/dev/null | grep -qxF \"${containerWorkspaceFolder}\" || git config --global --add safe.directory \"${containerWorkspaceFolder}\"",
  // 1313 is the Hugo dev server, preview:8043 is the goStatic service, 9323 is
  // the Playwright HTML report (`make report`, or served automatically after a
  // failing run).
  "forwardPorts": [1313, "preview:8043", 9323]
}
